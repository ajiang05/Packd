DATABASE_URL=postgresql://packd:packd_local_only@localhost:54329/packd
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=http://localhost:3000

# Local development only; production requires a trusted proxy with sanitized host headers.
AUTH_TRUST_HOST=true
# Optional collector; keep credentials in the secret manager.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# AI activity planner (server only). Both keys are required for suggestions.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
TAVILY_API_KEY=
# Global requests per rolling 24-hour window; also limited to 5/user/minute.
AI_DAILY_REQUEST_LIMIT=100

# Optional: dedicated demo account; only honored by npm run dev on localhost.
ALLOW_DEV_LOGIN=false
