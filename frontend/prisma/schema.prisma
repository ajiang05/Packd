generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth) models — required shape for the Prisma adapter ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts      Account[]
  sessions      Session[]

  tripsCreated       Trip[]              @relation("TripCreator")
  tripMemberships    TripMember[]        @relation("TripMemberUser")
  membersAdded       TripMember[]        @relation("TripMemberAddedBy")
  activitiesProposed Activity[]
  votes              Vote[]
  checklistItems     ChecklistItem[]
  contributions      BudgetContribution[]
  scheduleItemsAdded ScheduleItem[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Packd domain models ---

enum BudgetType {
  TOTAL
  PER_PERSON
}

enum ActivityStatus {
  PENDING
  APPROVED
  NOT_APPROVED
}

model Trip {
  id          String     @id @default(cuid())
  name        String
  destination String?
  startDate   DateTime
  endDate     DateTime
  budgetType  BudgetType @default(TOTAL)
  budgetAmount Decimal?  @db.Decimal(10, 2)
  createdById String
  createdAt   DateTime   @default(now())

  createdBy     User                @relation("TripCreator", fields: [createdById], references: [id])
  members       TripMember[]
  activities    Activity[]
  checklistItems ChecklistItem[]
  contributions BudgetContribution[]
  scheduleItems ScheduleItem[]
}

// AC 1.2: a member can only be removed by whoever added them — addedById tracks that.
model TripMember {
  id          String   @id @default(cuid())
  tripId      String
  userId      String
  addedById   String
  joinedAt    DateTime @default(now())

  trip    Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user    User @relation("TripMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User @relation("TripMemberAddedBy", fields: [addedById], references: [id])

  @@unique([tripId, userId])
}

// status is derived from votes (strict majority yes = APPROVED, tie = NOT_APPROVED)
// and recalculated server-side whenever a vote is cast — stored here so it can be
// queried/filtered without re-aggregating votes on every read.
model Activity {
  id            String         @id @default(cuid())
  tripId        String
  name          String
  description   String?
  status        ActivityStatus @default(PENDING)
  proposedById  String
  createdAt     DateTime       @default(now())

  trip       Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  proposedBy User   @relation(fields: [proposedById], references: [id])
  votes      Vote[]
}

model Vote {
  id         String   @id @default(cuid())
  activityId String
  userId     String
  value      Boolean
  createdAt  DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
}

// Personal, per-user checklist scoped to a trip (AC 4.1/4.2) — not shared/blocking.
model ChecklistItem {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  title     String
  isChecked Boolean  @default(false)
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BudgetContribution {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  amount    Decimal  @db.Decimal(10, 2)
  note      String?
  createdAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScheduleItem {
  id                   String    @id @default(cuid())
  tripId               String
  title                String
  description          String?
  startTime            DateTime
  endTime              DateTime?
  googleCalendarEventId String?
  createdById          String
  createdAt            DateTime  @default(now())

  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy User @relation(fields: [createdById], references: [id])
}
